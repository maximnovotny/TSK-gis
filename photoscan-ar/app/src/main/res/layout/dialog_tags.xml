<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView android:id="@+id/txtDetected"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/on_bg" android:textSize="14sp" />

    <TextView style="@style/Hud.Label"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" android:text="@string/tags_add_distance" />

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:orientation="horizontal">
        <EditText android:id="@+id/editFrom" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:hint="@string/tags_from" android:inputType="number"
            android:autofillHints="" android:textColor="@color/on_bg" />
        <EditText android:id="@+id/editTo" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="8dp" android:hint="@string/tags_to"
            android:inputType="number" android:autofillHints="" android:textColor="@color/on_bg" />
        <EditText android:id="@+id/editDistance" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1.3"
            android:layout_marginStart="8dp" android:hint="@string/tags_distance_m"
            android:inputType="numberDecimal" android:autofillHints="" android:textColor="@color/on_bg" />
    </LinearLayout>

    <Button android:id="@+id/btnAddDistance"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="@string/tags_add_distance" />

    <TextView android:id="@+id/txtDistances"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="14dp" android:fontFamily="monospace"
        android:textColor="@color/on_bg_dim" android:textSize="12sp" />
</LinearLayout>
