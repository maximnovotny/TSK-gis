<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <TextView android:id="@+id/txtHeader"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="16dp" android:textColor="@color/on_bg" android:textSize="13sp" />

    <ProgressBar android:id="@+id/progress"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        style="?android:attr/progressBarStyleHorizontal" android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout android:id="@+id/list"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingHorizontal="12dp"
            android:paddingBottom="24dp" />
    </ScrollView>
</LinearLayout>
