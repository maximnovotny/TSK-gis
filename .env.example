# Copy to .env and fill in. Never commit the filled-in file.

# --- routing -----------------------------------------------------------------
ELYS_HOST=elys.example.com
ACME_EMAIL=admin@example.com

# --- database ----------------------------------------------------------------
POSTGRES_USER=elys
POSTGRES_PASSWORD=change-me
POSTGRES_DB=elys

# --- model -------------------------------------------------------------------
# anthropic = hosted (MVP default) | ollama = on-premise, no internet egress
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
# claude-sonnet-5 is the cheaper option if generation volume is high.
ANTHROPIC_MODEL=claude-opus-5

# Used when LLM_PROVIDER=ollama. Start the model host with:
#   docker compose --profile onprem up -d
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=gemma3:12b
